# ─── RestoPro litsenziya serveri ───────────────────────────────
# Port (nginx shu portga proxy qiladi)
PORT=7070
# Ma'lumotlar papkasi: kalitlar (keys.json) va mijozlar (db.json).
# MUHIM: bu papkani zaxiralang. keys.json yo'qolsa, barcha restoranlarni
# yangi ochiq kalit bilan qayta sozlash kerak bo'ladi.
DATA_DIR=./data
# Admin panelga kirish paroli (kamida 10 belgi). Login: admin
ADMIN_PASSWORD=
# To'lov muddati o'tgandan keyin necha kun ogohlantirish bilan ishlashi mumkin
GRACE_DAYS=3
# Bloklangan ekranda restoranga ko'rsatiladigan aloqa (telefon, Telegram)
VENDOR_CONTACT=+998 90 000 00 00
