# ─── MongoDB ───────────────────────────────────
# MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/restopro
# Local MongoDB:  mongodb://localhost:27017/restopro
MONGO_URI=mongodb://localhost:27017/restopro

# ─── JWT ────────────────────────────────────────
# MAJBURIY. Kamida 32 belgi, har bir mijoz uchun alohida. Yaratish:
#   openssl rand -hex 32
# Bo'sh yoki oddiy bo'lsa server ishga tushmaydi.
JWT_SECRET=
# Token amal qilish muddati (masalan: 12h, 7d)
JWT_EXPIRES_IN=7d

# ─── Birinchi admin ─────────────────────────────
# Bo'sh qoldirilsa, birinchi ishga tushishda tasodifiy parol yaratilib
# konsolga (pm2 logs) chiqariladi. Birinchi kirishda parol almashtiriladi.
ADMIN_PASSWORD=

# ─── Server ─────────────────────────────────────
PORT=5000

# ─── CORS ───────────────────────────────────────
# Frontend manzili (vergul bilan ajratib bir nechta kiritish mumkin)
CLIENT_URL=http://localhost:5173
# ngrok / cloudflare tunnel orqali test qilish uchun (production'da false)
ALLOW_TUNNELS=false

# ─── Zaxira nusxa (deploy/backup.sh) ────────────
# Arxivlar papkasi va nechta oxirgi arxiv saqlanishi
BACKUP_DIR=/var/backups/restopro
BACKUP_KEEP=14
# Ixtiyoriy: har bir arxivni Telegram'ga yuborish (server buzilsa ham nusxa qoladi)
# Bot: @BotFather → /newbot.  Chat ID: botga yozing, so'ng
#   https://api.telegram.org/bot<TOKEN>/getUpdates  dan "chat":{"id":...}
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=

# ─── Offline kassa sinxronlash ──────────────────
# CLOUD serverda: kassalar ulanadigan maxfiy kalit (kamida 32 belgi).
#   openssl rand -hex 32
SYNC_KEY=
# KASSA (Electron) da: cloud manzili. Bo'sh bo'lsa sync o'chiq.
# SYNC_URL=https://cafe.example.uz
# NODE_ID=kassa
# SYNC_INTERVAL=15
# Frontendni shu server o'zi beradi (nginx'siz, LAN rejimi):
# SERVE_FRONTEND=../frontend/dist
